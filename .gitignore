# fnos-kiosk 项目忽略

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.egg-info/
.pytest_cache/

# 本地开发/测试日志
app/bin/dash.log

# 编辑器 / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# 构建产物（生成图标后会被纳入 FPK，但本地仓库不需要追踪）
app/ui/images/icon-64.png
app/ui/images/icon-256.png
app/web/images/icon-64.png
app/web/images/icon-256.png

# fnpack 输出（com.fnos.kiosk.fpk 例外：要随仓库发布，方便 raw 访问）
*.fpk
!com.fnos.kiosk.fpk

# 本地预览临时
.local/
.env

# 测试用的临时文件
test_config.json
test_var/
test_var_*/
app/bin/test_var*/
app/bin/test_var/

# 私钥 / 配置（若开发中本地放了的）
etc/dev-*.json